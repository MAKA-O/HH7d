# =====================================================================
#  Интеллектуальный тренажёр для подготовки к собеседованиям
#  Скопируйте этот файл в backend/.env и при необходимости измените.
# =====================================================================

# --- Безопасность ---
# Сгенерируйте свой ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Не короче 32 байт — иначе PyJWT предупреждает о слабом HMAC-ключе.
SECRET_KEY=dev-secret-change-me-in-production-please-use-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- База данных ---
# По умолчанию SQLite-файл backend/data/app.db создаётся автоматически.
# Example: DATABASE_URL=sqlite:///C:/path/to/app.db
#DATABASE_URL=

# =====================================================================
#  ИИ — обязательный компонент проекта
#  Режимы AI_PROVIDER:
#    auto     — есть ключ → живая модель, нет ключа → офлайн-движок
#    gemini   — Google Gemini (OpenAI-совместимый шлюз), только вставьте ключ
#    openai   — OpenAI / OpenRouter / DeepSeek / VseGPT / любой совместимый API
#    ollama   — локальная модель через Ollama (без интернета и оплаты)
#    offline  — принудительно встроенный офлайн-движок (демонстрация без ключа)
#
#  ВАЖНО: без ключа проект полностью работоспособен в офлайн-режиме.
# =====================================================================
AI_PROVIDER=gemini
# ↓↓↓ ВСТАВЬТЕ СВОЙ КЛЮЧ ЗДЕСЬ (ключ Google AI Studio, начинается на AIza...) ↓↓↓
AI_API_KEY=
# ↑↑↑ больше ничего менять не нужно: адрес и модель подставятся автоматически ↑↑↑
# Быстрая бесплатная модель (рекомендуется для мгновенных ответов).
# Альтернативы: gemini-3.6-flash (качественнее, но медленнее),
# gemini-3.5-flash, gemini-3.8-flash (может быть недоступна на free tier → 429).
AI_MODEL=gemini-3.5-flash-lite

# Резервные модели через запятую: используются по порядку, если основная
# ответила 429 (квота), 404 (модель недоступна) или 503 (перегрузка).
# Пример: AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash
AI_MODEL_FALLBACKS=

# Несколько ключей API через запятую — из РАЗНЫХ проектов Google.
# Квота Gemini считается на ПРОЕКТ, а не на отдельный ключ, поэтому второй
# проект = отдельные лимиты и второй шанс, когда первый исчерпан (429).
# Первый ключ основной; если строка пуста — используется AI_API_KEY выше.
#AI_API_KEYS=AIzaSy...проект1...,AIzaSy...проект2...

# «Остывание» неудачных связок (секунды), чтобы не упираться в те же ошибки:
#   429 «квота исчерпана» — связка ключ+модель (RPM/TPM восстанавливаются за минуту,
#        RPD — в полночь по Тихоокеанскому времени: для UTC+5 это ~13:00 местного);
#   401/403 — невалидный ключ (плохой ключ не трогаем час);
#   404 / 400 «модель не поддерживается» — модель.
AI_QUOTA_COOLDOWN_SEC=900
AI_KEY_COOLDOWN_SEC=3600
AI_MODEL_COOLDOWN_SEC=3600

# AI_BASE_URL при AI_PROVIDER=gemini задаётся автоматически:
#   https://generativelanguage.googleapis.com/v1beta/openai
# Указывать явно нужно только для нестандартного шлюза:
#AI_BASE_URL=
AI_TEMPERATURE=0.6
# Таймаут и число повторов: быстрый отказ вместо долгого ожидания
AI_TIMEOUT_SEC=45
AI_MAX_RETRIES=1
# После сбоя (квота 429 / сеть) — столько секунд работать офлайн без ожидания.
# Сначала при 429/404/503 приложение пробует резервные модели (AI_MODEL_FALLBACKS)
# и альтернативные ключи (AI_API_KEYS), и только если все варианты исчерпаны —
# уходит в офлайн-режим.
AI_FAILURE_COOLDOWN_SEC=120
# Необязательно: режим «размышления» reasoning-моделей (minimal/low/medium/high/none).
# Если модель не поддерживает уровень, параметр будет отброшен автоматически.
#AI_REASONING_EFFORT=

# --- Вариант «Gemini вручную» (то же самое через OpenAI-совместимый режим) ---
#AI_PROVIDER=openai
#AI_API_KEY=AIza...
#AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#AI_MODEL=gemini-3.5-flash-lite

# --- OpenAI ---
#AI_PROVIDER=openai
#AI_API_KEY=sk-...
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini

# --- OpenRouter (есть бесплатные модели) ---
#AI_PROVIDER=openai
#AI_API_KEY=sk-or-v1-...
#AI_BASE_URL=https://openrouter.ai/api/v1
#AI_MODEL=google/gemini-3.5-flash-lite

# --- DeepSeek ---
#AI_PROVIDER=openai
#AI_API_KEY=sk-...
#AI_BASE_URL=https://api.deepseek.com/v1
#AI_MODEL=deepseek-chat

# --- Локальная Ollama ---
#AI_PROVIDER=ollama
#AI_BASE_URL=http://localhost:11434/v1
#AI_MODEL=qwen2.5:7b
#AI_API_KEY=ollama
