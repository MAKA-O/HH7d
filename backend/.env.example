# =====================================================================
#  Интеллектуальный тренажёр для подготовки к собеседованиям
#  Скопируйте этот файл в backend/.env и при необходимости измените.
# =====================================================================

# --- Безопасность ---
# Сгенерируйте свой ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Не короче 32 байт — иначе PyJWT предупреждает о слабом HMAC-ключе.
SECRET_KEY=dev-secret-change-me-in-production-please-use-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- База данных ---
# По умолчанию SQLite-файл backend/data/app.db создаётся автоматически.
# Example: DATABASE_URL=sqlite:///C:/path/to/app.db
#DATABASE_URL=

# =====================================================================
#  ИИ (обязательный компонент проекта)
#  Режимы AI_PROVIDER:
#    auto     — есть ключ → живая модель, нет ключа → офлайн-движок (по умолчанию)
#    openai   — OpenAI / OpenRouter / DeepSeek / VseGPT и любой совместимый API
#    ollama   — локальная модель через Ollama (без интернета и оплаты)
#    offline  — принудительно встроенный офлайн-движок (демонстрация без ключа)
# =====================================================================
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.6
AI_TIMEOUT_SEC=90

# --- Вариант 1: OpenAI ---
#AI_PROVIDER=openai
#AI_API_KEY=sk-...
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini

# --- Вариант 2: OpenRouter (есть бесплатные модели) ---
#AI_PROVIDER=openai
#AI_API_KEY=sk-or-v1-...
#AI_BASE_URL=https://openrouter.ai/api/v1
#AI_MODEL=google/gemini-2.0-flash-exp:free

