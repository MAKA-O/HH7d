{
  "name": "interview-trainer-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "SPA тренажёра для подготовки к собеседованиям (React 18 + TypeScript + Vite + Tailwind)",
  "scripts": {
    "dev": "node --require ./scripts/sandbox-spawn-workaround.cjs ./node_modules/vite/bin/vite.js",
    "build": "tsc --noEmit && node --require ./scripts/sandbox-spawn-workaround.cjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/sandbox-spawn-workaround.cjs ./node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "oxc-transform-react": "^0.156.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^8.3.5"
  }
}
